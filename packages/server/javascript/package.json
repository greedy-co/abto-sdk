{
  "name": "@abto-app/calling",
  "version": "1.1.3",
  "description": "ABTO JavaScript Server SDK — Gateway routing, provider credentials, and request-scoped context propagation.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://docs.abto.app/sdk/javascript/server/",
  "bugs": {
    "url": "https://github.com/greedy-co/abto-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greedy-co/abto-sdk.git",
    "directory": "packages/server/javascript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "test:package": "node tests/package.mjs",
    "test:tracing": "node tests/tracing/run.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "abto",
    "gateway",
    "llm",
    "node",
    "observability",
    "server"
  ],
  "peerDependencies": {
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "openai": "^6.45.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
