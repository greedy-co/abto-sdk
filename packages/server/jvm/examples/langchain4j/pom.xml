<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>app.abto.examples</groupId><artifactId>calling-examples</artifactId><version>1.0.0</version></parent>
  <artifactId>langchain4j-example</artifactId>
  
  <dependencies><dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version></dependency><dependency><groupId>app.abto</groupId><artifactId>abto-calling-langchain4j</artifactId><version>${abto.version}</version></dependency><dependency><groupId>org.bsc.langgraph4j</groupId><artifactId>langgraph4j-core</artifactId><version>1.9.5</version></dependency></dependencies>
  <build><plugins><plugin><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId><version>${kotlin.version}</version>
    <executions><execution><id>kotlin</id><phase>process-sources</phase><goals><goal>compile</goal></goals></execution></executions>
    <configuration><compilerExecutionStrategy>in-process</compilerExecutionStrategy><jvmTarget>17</jvmTarget><sourceDirs><sourceDir>${project.basedir}/src/main/kotlin</sourceDir></sourceDirs></configuration>
  </plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
      <executions><execution><id>example</id><phase>verify</phase><goals><goal>java</goal></goals></execution></executions>
      <configuration><mainClass>example.LangChainExample</mainClass><commandlineArgs>${example.arguments}</commandlineArgs><cleanupDaemonThreads>false</cleanupDaemonThreads></configuration>
    </plugin>
  </plugins></build>
</project>
