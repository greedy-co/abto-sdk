{
  "name": "@abto-app/event",
  "version": "0.1.2",
  "description": "ABTO Browser SDK — autocapture, typed custom events, identity, sessions, and AI trace correlation.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://docs.abto.app/sdk/javascript/browser/",
  "bugs": {
    "url": "https://github.com/greedy-co/abto-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greedy-co/abto-sdk.git",
    "directory": "packages/browser/javascript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "abto",
    "analytics",
    "autocapture",
    "browser",
    "llm",
    "observability"
  ],
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
